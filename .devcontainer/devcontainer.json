{
  "name": "MLOps Monitoring Dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip setuptools wheel && pip install -r requirements.txt && pip install -e .",
  "forwardPorts": [
    8000,
    8080,
    5001
  ],
  "portsAttributes": {
    "5001": {
      "label": "MLflow UI",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Monitoring FastAPI",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Static dashboard",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}